rules_version = '2';

// Rate My Year Review Crew security rules.
// - Only signed-in people can touch crew data.
// - You join a crew by holding its current invite code.
// - Crew members see the crew and its people, write their own reviews,
//   and read reviews they wrote or reviews about the person they claimed.
// - Crew admins (the creator, plus anyone they promote) read every review.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function crewPath(c) { return /databases/$(database)/documents/crews/$(c); }
    function crewData(c) { return get(crewPath(c)).data; }
    function isAdmin(c) { return signedIn() && exists(crewPath(c)) && request.auth.uid in crewData(c).adminUids; }
    function hasJoined(c) { return signedIn() && exists(/databases/$(database)/documents/crews/$(c)/joins/$(request.auth.uid)); }
    function isMember(c) { return isAdmin(c) || hasJoined(c); }
    function docAt(c, sub, id) { return /databases/$(database)/documents/crews/$(c)/$(sub)/$(id); }
    function validCode(d) { return d.joinCode is string && d.joinCode.size() >= 6; }
    // Site owner (admin.html): read-only access to everything, for totals.
    function isSuper() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email in ['brad@epicagile.com.au'];
    }

    match /crews/{c} {
      allow get: if isMember(c) || isSuper();
      allow list: if isSuper();

      // Only a Google-signed-in crew admin can set up a crew; guests join by invite link.
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.adminUids == [request.auth.uid]
        && validCode(request.resource.data)
        && request.resource.data.get('type', 'family') in ['family', 'mates']
        && request.resource.data.members is list;

      // Admins can change anything except who owns the crew, and the owner always stays an admin.
      // Other members can only add people to the list.
      allow update: if (isAdmin(c)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && resource.data.ownerUid in request.resource.data.adminUids
          && validCode(request.resource.data))
        || (hasJoined(c)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members));

      // Crews are never deleted from the site, so a crew id can't be re-created
      // by someone else to read leftover data.
      allow delete: if false;

      // One doc per account that joined; created only with the current invite code.
      match /joins/{uid} {
        allow read: if isMember(c) || isSuper();
        // Join with the invite link's code, or with the crew password (stored as a hash).
        allow create, update: if signedIn() && uid == request.auth.uid
          && (request.resource.data.get('code', '') == crewData(c).joinCode
              || ('passHash' in crewData(c) && request.resource.data.get('pass', '') == crewData(c).passHash));
        allow delete: if isAdmin(c) || (signedIn() && uid == request.auth.uid);
      }

      // Which person each account is in the crew ("I am"): accounts/{uid} = {member}.
      // Several accounts (devices) can be the same person. claims/{memberId} records the
      // latest account to pick that name, for the admin tools.
      match /accounts/{uid} {
        allow read: if isMember(c);
        allow create, update: if isMember(c) && uid == request.auth.uid
          && request.resource.data.member is string;
        allow delete: if isAdmin(c) || (signedIn() && uid == request.auth.uid);
      }
      match /claims/{memberId} {
        allow read: if isMember(c);
        allow create, update: if isMember(c)
          && request.resource.data.uid == request.auth.uid
          && getAfter(docAt(c, 'accounts', request.auth.uid)).data.member == memberId;
        allow delete: if isAdmin(c) || (signedIn() && resource.data.uid == request.auth.uid);
      }

      match /reviews/{reviewId} {
        // Admins read all; you read reviews you wrote (on any of your devices) and reviews about you.
        allow read: if isAdmin(c) || isSuper()
          || (isMember(c) && resource.data.reviewerUid == request.auth.uid)
          || (isMember(c) && get(docAt(c, 'accounts', request.auth.uid)).data.member == resource.data.member)
          || (isMember(c) && get(docAt(c, 'accounts', request.auth.uid)).data.member == resource.data.reviewer);
        allow create: if isMember(c)
          && request.resource.data.reviewerUid == request.auth.uid
          && reviewId == request.auth.uid + '_' + request.resource.data.member
          && get(docAt(c, 'accounts', request.auth.uid)).data.member == request.resource.data.reviewer;
        allow update: if isMember(c)
          && resource.data.reviewerUid == request.auth.uid
          && request.resource.data.reviewerUid == request.auth.uid
          && request.resource.data.member == resource.data.member
          && (!('boardKey' in resource.data) || request.resource.data.get('boardKey', '') == resource.data.boardKey)
          && get(docAt(c, 'accounts', request.auth.uid)).data.member == request.resource.data.reviewer;
        // Only crew admins delete reviews, so nobody can delete and re-add to stack the leaderboard.
        allow delete: if isAdmin(c);
      }

      // Crew leaderboard: board/{memberId} = {by: {<key>: {o: overall, self: bool}}}.
      // Each reviewer adds or updates only the entry under the private key stored in their own review,
      // and its score must match that review. Everyone in the crew can read it; admins can tidy it.
      match /board/{memberId} {
        function myReview() { return getAfter(docAt(c, 'reviews', request.auth.uid + '_' + memberId)).data; }
        function entryOk(k) {
          return k is string && k.size() >= 12
            && request.resource.data.by[k].keys().hasOnly(['o', 'self'])
            && request.resource.data.by[k].o == myReview().overall
            && request.resource.data.by[k].self == (myReview().reviewer == memberId);
        }
        // The crew sees the leaderboard unless the admin turns it off (showBoard: false); admins always can.
        allow read: if isAdmin(c) || (isMember(c) && crewData(c).get('showBoard', true) != false);
        allow create: if isAdmin(c)
          || (isMember(c) && request.resource.data.keys().hasOnly(['by'])
              && request.resource.data.by.keys().hasOnly([myReview().boardKey])
              && entryOk(myReview().boardKey));
        allow update: if isAdmin(c)
          || (isMember(c) && request.resource.data.keys().hasOnly(['by'])
              && request.resource.data.by.diff(resource.data.by).affectedKeys().hasOnly([myReview().boardKey])
              && entryOk(myReview().boardKey));
        allow delete: if isAdmin(c);
      }
    }

    // Public list of crew names so people can search for their crew.
    // The doc id is the crew's unique slug; a crew can only claim its own name.
    match /crewNames/{slug} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.slug == slug
        && request.auth.uid in getAfter(crewPath(request.resource.data.crewId)).data.adminUids
        && getAfter(crewPath(request.resource.data.crewId)).data.slug == slug;
      allow update: if false;
      allow delete: if isAdmin(resource.data.crewId);
    }

    // Share Results: a record of each report card sent (channel, plus the email or mobile if given).
    // Anyone can add one for their own session; only the site owner reads them (Firebase console).
    match /shares/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.channel in ['email', 'whatsapp', 'sms', 'picture', 'saved']
        && request.resource.data.get('email', '') is string
        && request.resource.data.get('email', '').size() <= 200
        && request.resource.data.get('phone', '') is string
        && request.resource.data.get('phone', '').size() <= 30;
      allow read: if isSuper();
      allow update, delete: if false;
    }

    // Each person's list of crews, private to them.
    match /users/{uid} {
      allow read, write: if signedIn() && uid == request.auth.uid;
      allow list: if isSuper();
    }

    // Solo reviews saved outside a crew, private to the person who saved them.
    match /results/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSuper() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
